{
    "name": "pintos-dev",
    "build": {
        "dockerfile": "Dockerfile",
        "options": ["--platform=linux/amd64"]
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/pintos_22.04_lab_docker,type=bind",
    "workspaceFolder": "/workspaces/pintos_22.04_lab_docker",
    "runArgs": ["--platform=linux/amd64"],
    "remoteUser": "jungle",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cpptools",
                "ms-azuretools.vscode-docker",
                "ms-vscode.makefile-tools"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "C_Cpp.default.compilerPath": "/usr/bin/gcc",
                "C_Cpp.default.cStandard": "c99",
                "C_Cpp.default.includePath": [
                    "${workspaceFolder}/pintos/include",
                    "${workspaceFolder}/pintos/include/threads",
                    "${workspaceFolder}/pintos/include/devices",
                    "${workspaceFolder}/pintos/include/lib",
                    "${workspaceFolder}/pintos/include/lib/kernel",
                    "${workspaceFolder}/pintos/include/userprog",
                    "${workspaceFolder}/pintos/include/vm",
                    "/usr/include",
                    "/usr/local/include"
                ]
            }
        }
    }
}
